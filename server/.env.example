PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lakehead
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@lakeheadedu.com
ADMIN_PASSWORD=ChangeMe123!
NODE_ENV=development

# Optional — real Google rating in the footer. Leave blank to keep the static one.
# Key: Google Cloud console, Places API (New) enabled, restricted to this server's IP.
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Success Stories videos on the home page — set ONE of these (optional).
# The playlist is preferred: only videos you add to it appear on the site,
# and adding one publishes it with no deploy. Find the id in the playlist's
# URL — youtube.com/playlist?list=PLxxxxxxxx — it is the part after "list=".
YOUTUBE_PLAYLIST_ID=
# Or the channel's latest uploads instead. The id starts "UC" and is in
# YouTube Studio under Settings > Channel > Advanced settings.
YOUTUBE_CHANNEL_ID=
