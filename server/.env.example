PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lakehead
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@lakeheadedu.com
ADMIN_PASSWORD=ChangeMe123!

# The code typed into the hidden door in the site footer (two clicks on the
# logo). Required — the server will not start without it. It gates the
# sign-in endpoint itself, so nobody can even attempt a password without it.
# Twelve characters minimum. It is a second lock, never a substitute for a
# strong ADMIN_PASSWORD.
ADMIN_GATE_CODE=change-this-to-a-long-phrase
NODE_ENV=development

# Optional — the real Google rating in the footer and the review cards above
# it. Leave blank and the footer keeps its static score and the review section
# renders nothing at all.
#   Key:      Google Cloud console, Places API (New) enabled, restricted to
#             this server's IP. It is used server-side only, never shipped
#             to the browser.
#   Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# Note: the call asks for `reviews`, which bills at a higher tier than the
# score alone, and Google returns at most 5 of them. The 12h cache in
# googleRating.service.ts is what keeps that to a couple of calls a day.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Success Stories videos on the home page — set ONE of these (optional).
# The playlist is preferred: only videos you add to it appear on the site,
# and adding one publishes it with no deploy. Find the id in the playlist's
# URL — youtube.com/playlist?list=PLxxxxxxxx — it is the part after "list=".
YOUTUBE_PLAYLIST_ID=
# SET THIS TOO, not instead. YouTube's playlist feed fails intermittently
# (bursts of 404s and 500s on a perfectly valid public playlist), and the
# channel feed is what the server falls back to when it does. Without it, a
# bad spell at YouTube's end means an empty row.
# This must be the id that starts
# "UC" — a handle like @yourchannel is NOT accepted. Find it in YouTube
# Studio under Settings > Channel > Advanced settings.
YOUTUBE_CHANNEL_ID=

# Outgoing mail — the notification a counsellor gets when a form is filled in.
# ALL OPTIONAL. Leave them blank and the server behaves exactly as it did
# before mail existed: inquiries are saved and appear in the admin dashboard,
# nothing is emailed, and the dashboard marks each one "skipped" so it is
# obvious why. Fill them in to turn notifications on — no deploy needed, the
# server reads them at boot.
#
# This is an ordinary mailbox, not a sending service: use the one you already
# have on the domain (Google Workspace, or your host's mail). Nodemailer just
# logs into it. Expect a daily send cap in the low hundreds, which is far more
# than this site's forms will ever produce.
#
#   MAIL_HOST    smtp.gmail.com for Google Workspace; ask your host otherwise
#   MAIL_PORT    587 for STARTTLS (use this), or 465 for implicit TLS.
#                NOT 25 — Render and every other cloud host blocks outbound 25.
#   MAIL_SECURE  "true" ONLY on port 465. On 587 it must stay false: the
#                connection opens in the clear and STARTTLS upgrades it.
#   MAIL_USER    the full mailbox address to authenticate as. Use a mailbox
#                created FOR the website, not a person's and not the shared
#                info@ inbox: this password sits in a config file, so if it
#                ever leaks you want to disable one account nobody reads
#                rather than the inbox the business runs on.
#   MAIL_PASS    Google Workspace: an App Password, generated with 2FA turned
#                on. The normal account password will not authenticate.
#   MAIL_FROM    what recipients see in the From line. Must be a mailbox on a
#                domain we are allowed to send as or SPF/DMARC will reject it.
#                Defaults to MAIL_USER. Never the enquirer's own address —
#                their address goes in Reply-To, which the server sets itself.
#   MAIL_TO      who gets notified. Comma-separated for more than one person.
# Microsoft 365 / Outlook: smtp.office365.com, port 587, MAIL_SECURE=false.
# Read the note at the bottom of this file first — Microsoft turns SMTP AUTH
# off by default and has been retiring password-based SMTP altogether.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
# The dedicated sending mailbox — NOT the inbox that receives the forms.
MAIL_USER=website@lakehead.edu.np
MAIL_PASS=
# Send AS the company mailbox on our own domain. Sending as the enquirer's
# address would fail SPF/DMARC at the receiving end — their address is set as
# Reply-To by the server instead, so replying still reaches them.
MAIL_FROM=website@lakehead.edu.np
# Where a filled-in form lands. Comma-separate to notify more than one person,
# e.g. info@lakehead.edu.np,counselling@lakehead.edu.np
MAIL_TO=info@lakehead.edu.np

# ─────────────────────────────────────────────────────────────────────────
# MICROSOFT 365 / OUTLOOK — read before setting the values above
#
# Two things stand between a new M365 mailbox and a working send:
#
#  1. SMTP AUTH is OFF by default on every mailbox. An admin turns it on per
#     mailbox: Microsoft 365 admin centre > Users > the mailbox > Mail >
#     Manage email apps > tick "Authenticated SMTP". It can also be blocked
#     tenant-wide in the Exchange admin centre, which overrides the per-user
#     setting.
#
#  2. Microsoft has been retiring BASIC auth (plain username + password) for
#     SMTP client submission in Exchange Online. Depending on when the tenant
#     was set up and what has already been enforced on it, password-based
#     SMTP may refuse to authenticate no matter how correct the settings are.
#     `npm run mail:check` tells you in seconds which side of that line this
#     tenant is on — run it before assuming either way.
#
# If basic SMTP is unavailable, mail.service.ts is the only file that has to
# change: it is the single place that knows how mail leaves. The two ways on
# from there are Microsoft Graph's sendMail over HTTPS (an Azure app
# registration with the Mail.Send application permission), or a transactional
# provider such as Resend. Neither touches the controller, the model, the
# dashboard or any form.
# ─────────────────────────────────────────────────────────────────────────
